use "nginx.wfs"

// 同一 client_ip 在 1 分钟内 5xx >= 3 次 → 突发告警
rule nginx_5xx_surge {
    events { c : nginx_access && c.http_status == "500" }
    match<client_ip:1m> {
        on event { c | count >= 3; }
    } -> score(70.0)
    entity(ip, c.client_ip)
    yield nginx_alerts (
        alert_type = "http_5xx_surge",
        client_ip = c.client_ip,
        uri = c.uri,
        detail = fmt("client_ip={} uri={}", c.client_ip, c.uri)
    )
    limits { max_memory = "64MB"; max_instances = 10000; on_exceed = throttle; }
}
